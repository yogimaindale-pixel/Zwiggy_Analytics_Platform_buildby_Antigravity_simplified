# Database Target Engine: 'sqlite', 'duckdb', or 'postgres'
DB_ENGINE=sqlite
DB_PATH=zwiggy_warehouse.db

# Source Database Settings (for PostgreSQL or SQLite source)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zwiggy_db
PG_USER=postgres
PG_PASSWORD=postgres

# Operational Settings
DEFAULT_LOOKBACK_DAYS=7
BATCH_SIZE=10000
BUSINESS_TIMEZONE=UTC
CODE_VERSION=1.0.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
